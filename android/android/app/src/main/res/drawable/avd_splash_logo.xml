<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ animated splash icon (windowSplashScreenAnimatedIcon). Same geometry as docs/brand/logo.svg,
    scaled into the 288dp icon box so it stays inside the 192dp visible circle. Plays within 1000 ms:
    rays turn, the sun breathes in and the moon glides over it.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group android:translateX="66" android:translateY="66" android:scaleX="1.3" android:scaleY="1.3">
                <group android:name="rays" android:pivotX="60" android:pivotY="60">
                    <group android:pivotX="60" android:pivotY="60" android:rotation="0">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="45">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="90">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="135">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="180">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="225">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="270">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                    <group android:pivotX="60" android:pivotY="60" android:rotation="315">
                        <path android:fillColor="@color/brand_amber" android:pathData="M56,8a4,4 0,0 1,8 0v8a4,4 0,0 1,-8 0z" />
                    </group>
                </group>
                <group android:name="sun" android:pivotX="60" android:pivotY="60">
                    <path android:pathData="M30,60a30,30 0,1 0,60 0a30,30 0,1 0,-60 0z">
                        <aapt:attr name="android:fillColor">
                            <gradient android:type="radial" android:centerX="51" android:centerY="49"
                                android:gradientRadius="45" android:startColor="@color/brand_amber_soft"
                                android:endColor="@color/brand_amber" />
                        </aapt:attr>
                    </path>
                </group>
                <group android:name="moon">
                    <path android:fillColor="@color/brand_night" android:pathData="M52,48a24,24 0,1 0,48 0a24,24 0,1 0,-48 0z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="rays">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:valueFrom="-90" android:valueTo="0"
                android:duration="1000" android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="700" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="700" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="moon">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="44" android:valueTo="0"
                android:startOffset="200" android:duration="800"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
</animated-vector>
